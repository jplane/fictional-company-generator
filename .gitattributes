# Normalize text to LF in Git and on macOS, Windows, and Linux.
* text=auto eol=lf

# Use CRLF for Windows command scripts in the working tree.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never apply text normalization to Office documents or binary assets.
*.docx binary
*.docm binary
*.pptx binary
*.pptm binary
*.xlsx binary
*.xlsm binary
*.doc binary
*.ppt binary
*.xls binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
